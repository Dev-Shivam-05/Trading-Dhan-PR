{
  "name": "dhan-option-chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only Dhan option chain terminal with a request/response latency panel",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server/index.ts",
    "check": "node --env-file-if-exists=.env scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "master:refresh": "node src/server/master.ts --refresh",
    "spike:gold": "node --env-file-if-exists=.env scripts/spike-gold.ts",
    "shots": "node scripts/shots.ts",
    "feed:probe": "node --env-file-if-exists=.env scripts/feed-probe.ts",
    "live:probe": "node --env-file-if-exists=.env scripts/live-probe.ts",
    "scan:nse": "node --env-file-if-exists=.env scripts/scan-nse.ts",
    "open:checks": "node --env-file-if-exists=.env scripts/open-checks.ts",
    "notify:test": "node --env-file-if-exists=.env scripts/notify-test.ts",
    "chart:selftest": "node scripts/chart-checks-test.ts",
    "oq1:test": "node scripts/oq1-reversal-test.ts",
    "oq1:live": "node --env-file-if-exists=.env scripts/oq1-live-probe.ts",
    "ltp:test": "node scripts/ltp-test.ts",
    "session:test": "node scripts/session-test.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
