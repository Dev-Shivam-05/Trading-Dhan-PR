# Copy to .env and fill in. .env is git-ignored and is read by the Node backend ONLY.
# These values must never reach the browser bundle (CI greps dist/ for them).
#
# Generate both from Dhan Web -> Profile -> DhanHQ Trading APIs -> Access Token.
# A DhanHQ Data API subscription is required for the option chain, quotes and live feed.

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Local backend port. The browser talks only to this.
PORT=8787
